# LixSketch - example environment for local development
#
# The committed `.env` is SOPS-encrypted and only maintainers can decrypt it.
# Newcomers: copy this file and fill in only what you need.
#
#   cp .env.example .env.local   # read by Next.js (overrides the encrypted .env)
#   cp .env.example .dev.vars    # read by `wrangler dev` (collab worker on :8787)
#
# Keep every key below in your copy, even when empty: an empty value in
# .env.local stops Next.js from picking up the encrypted `ENC[...]` value of
# the same key from `.env`.
#
# D1 (DB), KV and the ROOM Durable Object are Cloudflare bindings declared in
# wrangler*.toml and emulated locally by `npm run dev`; they are not env vars.
# Non-secret worker vars (ENVIRONMENT, APP_ORIGIN, ELIXPO_AUTH_URL,
# ROOM_TTL_HOURS, IDLE_TIMEOUT_MINS, MCP_RELAY_URL) already live in
# wrangler.dev.toml / wrangler.next.toml [vars].

# ---------------------------------------------------------------------------
# Required to run locally
# ---------------------------------------------------------------------------
# Nothing is strictly required: `npm run dev` boots with the values below left
# empty. These URLs are optional overrides; when unset the app falls back to
# the localhost defaults shown (see src/lib/env.js).
NEXT_PUBLIC_WORKER_URL=
# WebSocket endpoint of the collab worker (default ws://localhost:8787).
# NEXT_PUBLIC_COLLAB_URL is an older alias of the same setting.
NEXT_PUBLIC_ROOM_WS_URL=
NEXT_PUBLIC_COLLAB_URL=

# ---------------------------------------------------------------------------
# Optional integrations (leave empty; feature disabled)
# ---------------------------------------------------------------------------
# Elixpo Accounts sign-in (OAuth client registered on accounts.elixpo.com).
# Without these, sign-in does not work; guest usage is unaffected.
NEXT_PUBLIC_ELIXPO_AUTH_CLIENT_ID=
ELIXPO_AUTH_CLIENT_SECRET=
# Same OAuth client, as read by the collab worker (put in .dev.vars).
ELIXPO_CLIENT_ID=
ELIXPO_CLIENT_SECRET=

# AI diagram generation (/api/ai/generate).
POLLINATIONS_TEXT_API=
# "Connect Pollinations" integration. POLLINATIONS_APP_KEY must be a
# publishable key starting with pk_. For a throwaway local encryption key:
#   openssl rand -base64 32
POLLINATIONS_APP_KEY=
POLLINATIONS_CONNECTION_ENCRYPTION_KEY=

# Platform image uploads via Cloudinary (Next.js route /api/images/sign).
CLOUDINARY_KEY_=
CLOUDINARY_KEY_SECRET=
# Platform image uploads/deletes via Cloudinary (collab worker, put in .dev.vars).
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
# "Connect your own Cloudinary" OAuth integration. For a throwaway local
# encryption key:  openssl rand -base64 32
CLOUDINARY_OAUTH_CLIENT_ID=
CLOUDINARY_OAUTH_CLIENT_SECRET=
CLOUDINARY_CONNECTION_ENCRYPTION_KEY=

# Shared secret between the Next.js app and the collab worker for the MCP
# relay. Any random string works locally, but it must match in .env.local and
# .dev.vars:  openssl rand -hex 32
MCP_RELAY_SECRET=

# LixSketch MCP stdio server (packages/lixsketch/src/mcp/stdio.js). Only used
# when running the MCP CLI yourself, not by `npm run dev`.
LIXSKETCH_SCENE_FILE=./lixsketch-mcp.lixjson
LIXSKETCH_REMOTE_URL=
LIXSKETCH_WORKSPACE_ID=
LIXSKETCH_AGENT_TOKEN=
LIXSKETCH_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Deploy-only (maintainers)
# ---------------------------------------------------------------------------
# Used by deploy.sh / CI, never needed for local development.
GITHUB_ACCESS_TOKEN=
NPM_TOKEN=
VSCE_PAT=
# Declared as a worker secret in wrangler.toml; not read by current code.
SESSION_SECRET=
